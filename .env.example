# Copy to .env and adjust. All settings are optional; defaults live in app/config.py.

RAG_DATA_DIR=data
RAG_MAX_UPLOAD_MB=20

# Chunking, measured in embedding-model tokens
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Embeddings (Sentence Transformers)
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIM=384

# Retrieval
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# LLM (Ollama). Inside docker-compose this is http://ollama:11434
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_LLM_MODEL=llama3.2:3b
